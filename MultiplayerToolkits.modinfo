			<File>InGame/BetterPantheonChooser/NotificationPanel_MPT_Pantheon.lua</File>
		</ImportFiles>
		<!-- 条目32优化：万神殿通知文本 IG 侧注册（同文件 FE+IG 双注册，条目24 先例） -->
		<UpdateText id="IG_BPC_Text">
			<Properties>
				<LoadOrder>100</LoadOrder>
			</Properties>
			<File>InGame/BetterPantheonChooser/BetterPantheonChooser_zh_Hans_CN.sql</File>
			<File>InGame/BetterPantheonChooser/BetterPantheonChooser_en_US.sql</File>
		</UpdateText>
		<!-- 条目33：拯救开拓者数据（开拓者加原版伟人同款 CanRetreatWhenCaptured 撤退列；criteria 门控不勾选零改动） -->
		<UpdateDatabase id="IG_SaveSettler_Data" criteria="MPT_SAVE_SETTLER">
			<Properties>
				<LoadOrder>10</LoadOrder>
			</Properties>
			<File>InGame/SaveSettler/SaveSettler.sql</File>
		</UpdateDatabase>
		<!-- 条目33：拯救开拓者 Gameplay 侧（OnUnitRetreated 撤退回城：所在城市扣2人口，条目33调整废止≥3移除分支；criteria 门控不勾选零加载） -->
		<AddGameplayScripts id="IG_SaveSettler_Gameplay" criteria="MPT_SAVE_SETTLER">
			<Properties>
				<LoadOrder>900</LoadOrder>
			</Properties>
			<File>InGame/SaveSettler/SaveSettler_Gameplay.lua</File>
		</AddGameplayScripts>
		<!-- 条目33：拯救开拓者漂浮文本（Gameplay 脚本消费侧注册，条目21/22 先例） -->
