			NotificationPanel_QuickClear，反向语义同 1.67：勾选=禁用），lua 侧订阅
			MPT_Settings_Toggle 广播，初始状态经设置面板 LoadScreenClose ApplyAll 送达；
			优化（精确存活集/显隐计数/nil 守卫/按钮恒居底部论证）见文件头横幅 -->
		<ImportFiles id="IG_NotificationClear_Import">
			<Properties>
				<LoadOrder>1010</LoadOrder>
			</Properties>
			<File>InGame/NotificationClear/NotificationPanel_MPT.lua</File>
		</ImportFiles>
		<!-- 条目20：智能回合计时器（移植 1.67 CC/Timer TimerPro + NHK/UI/TurnTime_HotKey 热键与按钮）——
			房主回合末按「半数真人结束回合用时」PID 自动平衡 TURN_TIMER_TIME 并 BroadcastGameConfig
			广播全房；宣战/掉线加时、议会投票 120s、聊天指令 p+/p+++/p-、聊天框旁加/减时快捷按钮、
			]/[ 加减时热键。空 Context + 同名 Lua（同条目12/13 机制，1.67 两 Context 合并单文件）；
			开关在条目12 MPT_Settings 表加行（ParameterId 沿用 1.67 原 key TOOLS_COMMAND，默认 1
			=开启，每玩家本地开关——房主控自动平衡，非房主控自己按钮/热键），lua 侧订阅
			MPT_Settings_Toggle 广播，初始状态经设置面板 LoadScreenClose ApplyAll 送达；
			优化（零全局污染/DB.MakeHash 替代魔法数/真人统计合并/PID 单次计算/nil 防御/单调时钟
			冷却/联机门控）与语义差异见文件头横幅；15 秒滴答音与 NHK 强制结束回合不移植；
			与 1.67 同装时双方计时器会互相拉扯，勿同开 -->
		<AddUserInterfaces id="IG_SmartTimer">
			<Properties>
				<LoadOrder>900</LoadOrder>
				<Context>InGame</Context>
			</Properties>
			<File>InGame/SmartTurnTimer/SmartTurnTimer.xml</File>
		</AddUserInterfaces>
		<ImportFiles id="IG_SmartTimer_Import">
			<Properties>
				<LoadOrder>900</LoadOrder>
			</Properties>
			<File>InGame/SmartTurnTimer/SmartTurnTimer.lua</File>
		</ImportFiles>
		<UpdateDatabase id="IG_SmartTimer_Input">
			<Properties>
				<LoadOrder>10</LoadOrder>
			</Properties>
			<File>InGame/SmartTurnTimer/SmartTurnTimer_InputActions.xml</File>
		</UpdateDatabase>
		<UpdateText id="IG_SmartTimer_Text">
			<Properties>
				<LoadOrder>100</LoadOrder>
			</Properties>
			<File>InGame/SmartTurnTimer/SmartTurnTimer_zh_Hans_CN.sql</File>
			<File>InGame/SmartTurnTimer/SmartTurnTimer_en_US.sql</File>
		</UpdateText>
	</InGameActions>
