		<UpdateText id="FE_DPR_Text">
			<Properties>
				<LoadOrder>100</LoadOrder>
			</Properties>
			<File>InGame/DiplomacyRibbonExt/DiplomacyRibbonExt_zh_Hans_CN.sql</File>
			<File>InGame/DiplomacyRibbonExt/DiplomacyRibbonExt_en_US.sql</File>
