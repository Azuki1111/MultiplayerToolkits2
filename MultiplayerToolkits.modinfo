<!-- 联机工具箱 2.0 前端（Multiplayer Toolkits 2.0 FrontEnd）：融合联机工具箱与 MPH 前端功能，作者 号码菌Synora -->
<!-- LoadOrder 规约：1-99 配置 | 100-999 文本 | 1000-9999 UI替换 | 10000+ 覆盖型替换 | 99999+ 强制后置 -->
<Mod id="00000000-7369-4685-ab5f-bf77bc22b54e" version="1">
	<Properties>
		<Name>LOC_MPT_FE_NAME</Name>
		<Description>LOC_MPT_FE_DESCRIPTION</Description>
		<Teaser>LOC_MPT_FE_TEASER</Teaser>
		<Authors>LOC_MPT_FE_AUTHORS</Authors>
		<SpecialThanks>LOC_MPT_FE_THANKS</SpecialThanks>
		<AffectsSavedGames>0</AffectsSavedGames>
		<CompatibleVersions>1.2,2.0</CompatibleVersions>
		<!-- 修改时间元数据（时间戳）；版本校验指纹以 Version 为准 -->
		<Created>1786874927</Created>
		<!-- 模组版本一致性校验指纹：结构性更新必须递增 -->
		<Version>56</Version>
	</Properties>
	<!-- 本地化文本（前端 mod 信息占位，mod 完成时统一完善） -->
	<LocalizedText>
		<Text id="LOC_MPT_FE_NAME">
			<en_US>[ICON_ADDITIONALCONTENT]Multiplayer Toolkits [COLOR:ResGoldLabelCS]2.0.0 FrontEnd[ENDCOLOR]</en_US>
			<zh_Hans_CN>[ICON_ADDITIONALCONTENT]联机工具箱 [COLOR:ResGoldLabelCS]2.0.0 前端[ENDCOLOR]</zh_Hans_CN>
		</Text>
		<Text id="LOC_MPT_FE_DESCRIPTION">
			<en_US>[ICON_Bolt][COLOR:ResGoldLabelCS]Multiplayer Toolkits 2.0 FrontEnd[ENDCOLOR]
			[NEWLINE][NEWLINE][icon_Exclamation]FrontEnd features
			[NEWLINE][NEWLINE][icon_You]Staging Room enhancements
			[NEWLINE][icon_You]Mod version consistency check
			[NEWLINE][icon_You]Game setup presets for MP</en_US>
			<zh_Hans_CN>[ICON_Bolt][COLOR:ResGoldLabelCS]联机工具箱 2.0 前端[ENDCOLOR]
			[NEWLINE][NEWLINE][icon_Exclamation]前端功能
			[NEWLINE][NEWLINE][icon_You]准备房间增强
			[NEWLINE][icon_You]模组版本一致性校验
			[NEWLINE][icon_You]联机常用游戏设置预设</zh_Hans_CN>
		</Text>
		<Text id="LOC_MPT_FE_TEASER">
			<en_US>[size_32][COLOR:ResGoldLabelCS]Multiplayer Toolkits FrontEnd[ENDCOLOR]</en_US>
			<zh_Hans_CN>[size_32][COLOR:ResGoldLabelCS]联机工具箱 前端[ENDCOLOR]</zh_Hans_CN>
		</Text>
		<Text id="LOC_MPT_FE_AUTHORS">
			<en_US>[COLOR:ResGoldLabelCS]Synora[ENDCOLOR]</en_US>
			<zh_Hans_CN>[COLOR:ResGoldLabelCS]号码菌[ENDCOLOR]</zh_Hans_CN>
		</Text>
		<Text id="LOC_MPT_FE_THANKS">
			<en_US>Mod check / BP features adapted from Multiplayer Helper (MPH) by Cisco, D. &amp; Jack The Narrator, MIT License © 2024 BetterBalancedGame. Features also reference Team PVP Tools 1.67.</en_US>
			<zh_Hans_CN>模组校验 / BP 功能改编自 Multiplayer Helper (MPH)，作者 Cisco, D. 与 Jack The Narrator，MIT 协议 © 2024 BetterBalancedGame。部分功能参考联机工具箱 1.67。</zh_Hans_CN>
		</Text>
	</LocalizedText>
	<!-- 条目10：交易限制与外交限制（移植 1.67 DDV）条件注册（本 mod 首个 ActionCriteria 用例） -->
	<ActionCriteria>
		<!-- MPH 未启用时才注册本 mod 的交易参数与交易界面覆盖（MPH 定义同名参数，避免 Parameters 主键冲突） -->
		<Criteria id="Disable_MPH">
			<ModInUse inverse="1">619ac86e-d99d-4bf3-b8f0-8c5b8c402567</ModInUse>	<!--	Multiplayer Helper 1.7.2	-->
		</Criteria>
		<!-- 无代表团 -->
		<Criteria id="Diplomatic_delegation_Off">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>TPT_NO_DELEGATION</ConfigurationId>
				<Value>1</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<!-- 禁止宣布友谊 -->
		<Criteria id="Diplomatic_FS_Off">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>TPT_NO_FRIENDSHIP</ConfigurationId>
				<Value>1</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<!-- 允许和解 -->
		<Criteria id="Diplomatic_MP_ON">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>TPT_NO_MAKE_PEACE</ConfigurationId>
				<Value>CAN_MAKE_PEACE</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<!-- 无法和解 -->
		<Criteria id="Diplomatic_MP_Off">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>TPT_NO_MAKE_PEACE</ConfigurationId>
				<Value>NO_MAKE_PEACE</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<!-- 条目16：禁用地图钉（移植 1.67 RMP）——勾选高级选项「禁用地图钉」（CPL_NO_PINS）时生效（criteria id 镜像 1.67 命名） -->
		<Criteria id="No_Map_Pins">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>CPL_NO_PINS</ConfigurationId>
				<Value>1</Value>
			</ConfigurationValueMatches>
		</Criteria>
	</ActionCriteria>
	<FrontEndActions>
		<!-- 条目2：联机常用游戏设置预设（默认无蛮族开/回合60秒/允许重复文明领袖，新增禁用领袖池参数） -->
		<UpdateDatabase id="FE_Config_Base">
			<Properties>
				<LoadOrder>10</LoadOrder>
			</Properties>
			<File>FrontEnd/Config/Config_Base.xml</File>
		</UpdateDatabase>
		<!-- 条目10：交易限制配置（移植 1.67 DDV）——交易设置四模式（常规/经典/独立/自定义）+ 8 个禁止项 + 无代表团 + 无友谊；
			MPH 启用时不注册（同名参数冲突，由 MPH 提供） -->
		<UpdateDatabase id="FE_DDV_Config" criteria="Disable_MPH">
			<Properties>
				<LoadOrder>10</LoadOrder>
			</Properties>
			<File>InGame/DealRestriction/Config_Deal.xml</File>
			<File>InGame/DealRestriction/Config_Friendship.xml</File>
		</UpdateDatabase>
		<!-- 条目10：和解设置配置（无法和解/允许和解/默认；同 1.67 Cfg_MP 不门控） -->
		<UpdateDatabase id="FE_DDV_Config_MP">
			<Properties>
				<LoadOrder>10</LoadOrder>
			</Properties>
			<File>InGame/DealRestriction/Config_MakePeace.xml</File>
		</UpdateDatabase>
		<!-- 条目10：交易限制专属文本（不门控：INSERT OR REPLACE 幂等，MPH 共存时和解设置选项仍有文本） -->
		<UpdateText id="FE_DDV_Text">
			<Properties>
				<LoadOrder>100</LoadOrder>
			</Properties>
			<File>InGame/DealRestriction/DealRestriction_zh_Hans_CN.sql</File>
			<File>InGame/DealRestriction/DealRestriction_en_US.sql</File>
		</UpdateText>
		<!-- 前端通用本地化文本（每语言一个文件，同时注册进游戏内上下文；功能专属文本随功能文件夹，如 FrontEnd/Changelog/） -->
		<UpdateText id="FE_Text">
			<Properties>
				<LoadOrder>100</LoadOrder>
			</Properties>
			<File>FrontEnd/Text/FrontEnd_zh_Hans_CN.sql</File>
			<File>FrontEnd/Text/FrontEnd_en_US.sql</File>
		</UpdateText>
		<!-- 条目3.5：更新公告数据表 MPT_Changelog（面板仅前端使用，不进游戏内上下文） -->
		<UpdateDatabase id="FE_Changelog">
			<Properties>
				<LoadOrder>100</LoadOrder>
			</Properties>
			<File>FrontEnd/Changelog/Changelog_Data.sql</File>
		</UpdateDatabase>
		<!-- 条目3.5：更新公告专属文本（仅前端注册，通用文本仍走 FE_Text/IG_Text） -->
		<UpdateText id="FE_Changelog_Text">
			<Properties>
				<LoadOrder>100</LoadOrder>
			</Properties>
			<File>FrontEnd/Changelog/Changelog_zh_Hans_CN.sql</File>
			<File>FrontEnd/Changelog/Changelog_en_US.sql</File>
		</UpdateText>
		<!-- 条目3.6：广告轮播数据表 MPT_Ads（轮播仅前端使用，不进游戏内上下文） -->
		<UpdateDatabase id="FE_Ads">
			<Properties>
				<LoadOrder>100</LoadOrder>
			</Properties>
			<File>FrontEnd/Ads/Ads_Data.sql</File>
		</UpdateDatabase>
		<!-- 条目3.6：广告轮播专属文本（仅前端注册，与通用文本分离） -->
		<UpdateText id="FE_Ads_Text">
			<Properties>
				<LoadOrder>100</LoadOrder>
			</Properties>
			<File>FrontEnd/Ads/Ads_zh_Hans_CN.sql</File>
			<File>FrontEnd/Ads/Ads_en_US.sql</File>
		</UpdateText>
		<!-- 条目3.6：广告贴图导入 VFS（供轮播 SetTexture 按文件名解析） -->
		<ImportFiles id="FE_Import_Ads">
			<Properties>
				<LoadOrder>100010</LoadOrder>
			</Properties>
			<File>FrontEnd/Ads/QiaoEr_FFA.dds</File>
			<File>FrontEnd/Ads/QiaoEr_FFA2.dds</File>
			<File>FrontEnd/Ads/XiXueGuiTest1_.dds</File>
		</ImportFiles>
		<!-- 条目2：灾害强度下限 0 到 -1（完全无灾害），强制后置防覆盖 -->
		<UpdateDatabase id="FE_Config_DD">
			<Properties>
				<LoadOrder>99999</LoadOrder>
			</Properties>
			<File>FrontEnd/Config/Config_Disaster.sql</File>
		</UpdateDatabase>
		<!-- 条目1：LAN 玩家名长度 45（整文件同名覆盖原版 Options.xml，唯一改动 MaxLength 22 到 45） -->
		<ImportFiles id="FE_Replace_Options">
			<Properties>
				<LoadOrder>1000</LoadOrder>
			</Properties>
			<File>FrontEnd/UI/Options/Options.xml</File>
		</ImportFiles>
		<!-- 条目3：替换准备房间界面（LoadOrder 100000 压过其他同类模组；MPH LoadOrder 9999，共存时以本 mod 为准） -->
		<ReplaceUIScript id="FE_Replace_StagingRoom">
			<Properties>
				<LoadOrder>100000</LoadOrder>
				<LuaContext>StagingRoom</LuaContext>
				<LuaReplace>FrontEnd/UI/StagingRoom/StagingRoom.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<!-- 条目3：导入准备房间的 XML 布局与 Lua（XML 同名覆盖原版布局） -->
		<ImportFiles id="FE_Import_StagingRoom">
			<Properties>
				<LoadOrder>100010</LoadOrder>
			</Properties>
			<File>FrontEnd/UI/StagingRoom/StagingRoom.xml</File>
			<File>FrontEnd/UI/StagingRoom/StagingRoom.lua</File>
		</ImportFiles>
		<!-- 单人游戏模式：替换高级设置界面，允许移除全部AI、1人开局（参考 RL_Pangaea，唯一改动 minPlayers 为 1） -->
		<ReplaceUIScript id="FE_Replace_AdvancedSetup">
			<Properties>
				<LoadOrder>100000</LoadOrder>
				<LuaContext>AdvancedSetup</LuaContext>
				<LuaReplace>FrontEnd/UI/AdvancedSetup/AdvancedSetup.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<!-- 单人游戏模式：导入高级设置 Lua（XML 未改不导入） -->
		<ImportFiles id="FE_Import_AdvancedSetup">
			<Properties>
				<LoadOrder>100010</LoadOrder>
			</Properties>
			<File>FrontEnd/UI/AdvancedSetup/AdvancedSetup.lua</File>
		</ImportFiles>
		<!-- 条目4.1：模组校验注册表 MPT_ModCheck（各 mod 自我登记 modId 参与版本校验，仅前端配置库） -->
		<UpdateDatabase id="FE_ModCheck_Data">
			<Properties>
				<LoadOrder>100</LoadOrder>
			</Properties>
			<File>FrontEnd/ModCheck/ModCheck_Data.sql</File>
		</UpdateDatabase>
		<!-- 条目4.1：模组校验专属文本（仅前端注册，与通用文本分离） -->
		<UpdateText id="FE_ModCheck_Text">
			<Properties>
				<LoadOrder>100</LoadOrder>
			</Properties>
			<File>FrontEnd/ModCheck/ModCheck_zh_Hans_CN.sql</File>
			<File>FrontEnd/ModCheck/ModCheck_en_US.sql</File>
		</UpdateText>
		<!-- 条目4.2：准备房间非官方模组清单专属文本（仅前端注册；面板数据走运行时 Modding API，无数据表） -->
		<UpdateText id="FE_ModList_Text">
			<Properties>
				<LoadOrder>100</LoadOrder>
			</Properties>
			<File>FrontEnd/ModList/ModList_zh_Hans_CN.sql</File>
			<File>FrontEnd/ModList/ModList_en_US.sql</File>
		</UpdateText>
		<!-- 条目4.4：玩家标记管理专属文本（仅前端注册；纯本地玩家档案，数据走条目4.3 存储管线，无数据表；目录 Shared/PlayerMark/ 为双环境共享，当前仅前端消费） -->
		<UpdateText id="FE_PlayerMark_Text">
			<Properties>
				<LoadOrder>100</LoadOrder>
			</Properties>
			<File>Shared/PlayerMark/PlayerMark_zh_Hans_CN.sql</File>
			<File>Shared/PlayerMark/PlayerMark_en_US.sql</File>
		</UpdateText>
		<!-- 条目4.8：玩家标记 SQL 数据表 TPT_PlayerData（移植联机工具箱1.67 PlayerData.sql 有效行；显示逻辑见 StagingRoom.lua 条目4.8，仅前端配置库） -->
		<UpdateDatabase id="FE_PlayerMark_Data">
			<Properties>
				<LoadOrder>100</LoadOrder>
			</Properties>
			<File>Shared/PlayerMark/PlayerMark_Data.sql</File>
		</UpdateDatabase>
		<!-- 条目4.8：玩家标记图片 Tooltip 贴图导入 VFS（供 StagingRoom.xml ToolTipType AnDe/HuaMing/QingTian_Desc 按文件名解析） -->
		<ImportFiles id="FE_Import_PlayerMarkTT">
			<Properties>
				<LoadOrder>100010</LoadOrder>
			</Properties>
			<File>Shared/PlayerMark/AnDe_Desc_Texture.dds</File>
			<File>Shared/PlayerMark/HuaMing_Desc_Texture.dds</File>
			<File>Shared/PlayerMark/QingTian_Desc_Texture.dds</File>
		</ImportFiles>
		<!-- 条目4.5：图标查看器数据表 MPT_IconCollection（移植 EasyIconViewer 5056 图标，仅前端配置库） -->
		<UpdateDatabase id="FE_IconViewer_Data">
			<Properties>
				<LoadOrder>100</LoadOrder>
			</Properties>
			<File>FrontEnd/IconViewer/IconViewer_Data.sql</File>
		</UpdateDatabase>
		<!-- 条目4.5：图标查看器专属文本（仅前端注册，与通用文本分离） -->
		<UpdateText id="FE_IconViewer_Text">
			<Properties>
				<LoadOrder>100</LoadOrder>
			</Properties>
			<File>FrontEnd/IconViewer/IconViewer_zh_Hans_CN.sql</File>
			<File>FrontEnd/IconViewer/IconViewer_en_US.sql</File>
		</UpdateText>
		<!-- 条目4.6：贴图查看器数据表 MPT_TextureCollection（移植 TextureViewer 游戏本体+全部DLC UI 贴图 5017 行，仅前端配置库） -->
		<UpdateDatabase id="FE_TextureViewer_Data">
			<Properties>
				<LoadOrder>100</LoadOrder>
			</Properties>
			<File>FrontEnd/TextureViewer/TextureViewer_Data.sql</File>
		</UpdateDatabase>
		<!-- 条目4.6：贴图查看器专属文本（仅前端注册，与通用文本分离） -->
		<UpdateText id="FE_TextureViewer_Text">
			<Properties>
				<LoadOrder>100</LoadOrder>
			</Properties>
			<File>FrontEnd/TextureViewer/TextureViewer_zh_Hans_CN.sql</File>
			<File>FrontEnd/TextureViewer/TextureViewer_en_US.sql</File>
		</UpdateText>
		<!-- 条目16：禁用地图钉参数（移植 1.67 RMP/Config.xml）——高级选项「禁用地图钉」布尔开关（ParameterId 沿用
			1.67 原名 CPL_NO_PINS，与 1.67 同装时共用同一开关行，同条目10 保留参数名先例）；
			无条件注册（参数常在，设置界面复选框才显示），功能生效门控在 InGameActions 的 No_Map_Pins criteria -->
		<UpdateDatabase id="FE_NoPins_Config">
			<Properties>
				<LoadOrder>10</LoadOrder>
			</Properties>
			<File>InGame/DisableMapPins/Config_NoPins.xml</File>
		</UpdateDatabase>
		<!-- 条目16：禁用地图钉专属文本（设置界面复选框名称/描述，仅前端注册——游戏内无本条目文本；
			tag 沿用 1.67 原名，中文照抄 + 英文本 mod 补全） -->
		<UpdateText id="FE_DisableMapPins_Text">
			<Properties>
				<LoadOrder>100</LoadOrder>
			</Properties>
			<File>InGame/DisableMapPins/DisableMapPins_zh_Hans_CN.sql</File>
			<File>InGame/DisableMapPins/DisableMapPins_en_US.sql</File>
		</UpdateText>
		<!-- 条目20：智能计时器热键注册（移植 1.67 NHK/Config_TurnTime.xml，ActionId TPT_→MPT_）——
			GameInfo.InputActions + InputActionDefaultGestures（]/[ 键位），前后端各注册一次
			（FE 让主菜单按键绑定界面显示名称/描述，IG 供运行时 Input.GetActionId 取用） -->
		<UpdateDatabase id="FE_SmartTimer_Input">
			<Properties>
				<LoadOrder>10</LoadOrder>
			</Properties>
			<File>InGame/SmartTurnTimer/SmartTurnTimer_InputActions.xml</File>
		</UpdateDatabase>
		<!-- 条目20：智能计时器文本（热键名/描述 + 按钮 tooltip；前后端各注册，热键名主菜单也要显示） -->
		<UpdateText id="FE_SmartTimer_Text">
			<Properties>
				<LoadOrder>100</LoadOrder>
			</Properties>
			<File>InGame/SmartTurnTimer/SmartTurnTimer_zh_Hans_CN.sql</File>
			<File>InGame/SmartTurnTimer/SmartTurnTimer_en_US.sql</File>
		</UpdateText>
	</FrontEndActions>
	<InGameActions>
		<!-- 游戏内上下文注册同一份文本文件（其中的 LOC_MPT_FE_DUMMY_TEXT 为虚构示例，无任何引用） -->
		<UpdateText id="IG_Text">
			<Properties>
				<LoadOrder>100</LoadOrder>
			</Properties>
			<File>FrontEnd/Text/FrontEnd_zh_Hans_CN.sql</File>
			<File>FrontEnd/Text/FrontEnd_en_US.sql</File>
		</UpdateText>
		<!-- 条目5：显示地图角落——空 Context + 同名 Lua 自动执行，LoadScreenClose 时用透明 WorldAnchor 实例锚定地图两极，撑开相机包围盒使小地图全球比例（移植 1.67 RMC 自制版，不留 pin 数据） -->
		<AddUserInterfaces id="IG_RevealMapCorners">
			<Properties>
				<LoadOrder>100</LoadOrder>
				<Context>InGame</Context>
			</Properties>
			<File>InGame/RevealMapCorners/RevealMapCorners.xml</File>
		</AddUserInterfaces>
		<!-- 条目6：伟人名字更新——魔女环境下比赛纪念伟人改名（移植 1.67 GPN；条件插入，非魔女环境不生效） -->
		<UpdateText id="IG_GreatPersonNames">
			<Properties>
				<LoadOrder>5000000</LoadOrder>
			</Properties>
			<File>InGame/GreatPersonNames/GreatPersonNames.sql</File>
		</UpdateText>
