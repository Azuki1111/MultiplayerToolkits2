		<!-- 条目28：更多快捷键参数（高级选项布尔 MPT_NEW_HOTKEYS，仅 FE 注册） -->
		<UpdateDatabase id="FE_NHK_Config">
			<Properties>
				<LoadOrder>10</LoadOrder>
			</Properties>
