		<!-- 条目34：反作弊监测面板文本（面板 UI 消费侧注册 + 同文件 FE 侧注册；criteria 门控不勾选零加载） -->
		<UpdateText id="IG_HashCheck_Text" criteria="MPT_HASH_CHECK">
			<Properties>
				<LoadOrder>100</LoadOrder>
			</Properties>
			<File>InGame/HashCheck/HashCheck_zh_Hans_CN.sql</File>
			<File>InGame/HashCheck/HashCheck_en_US.sql</File>
		</UpdateText>
		<!-- 条目34：反作弊监测面板（空 Context AddUserInterfaces，入口=条目8 QuickPanel「反作弊监测」按钮；criteria 门控不勾选零加载） -->
		<AddUserInterfaces id="IG_MPT_HashCheckUI" criteria="MPT_HASH_CHECK">
			<Properties>
				<LoadOrder>900</LoadOrder>
				<Context>InGame</Context>
			</Properties>
			<File>InGame/HashCheck/MPT_HashCheckUI.xml</File>
		</AddUserInterfaces>
		<!-- 条目34：反作弊监测面板脚本（与 XML 同名自动执行；criteria 门控不勾选零加载） -->
		<ImportFiles id="IG_MPT_HashCheckUI_Import" criteria="MPT_HASH_CHECK">
			<File>InGame/HashCheck/MPT_HashCheckUI.lua</File>
		</ImportFiles>
	</InGameActions>
