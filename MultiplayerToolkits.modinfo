			<Properties>
				<LoadOrder>100</LoadOrder>
			</Properties>
			<File>InGame/SaveSettler/SaveSettler_zh_Hans_CN.sql</File>
			<File>InGame/SaveSettler/SaveSettler_en_US.sql</File>
