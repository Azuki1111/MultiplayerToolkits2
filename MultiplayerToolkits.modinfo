		<!-- 条目26：通知栏提醒扩展（NDR = Notification Deal Remind 交易提醒 + GPR 他人招募伟人通知）
			两 lua 文件名前缀 NotificationPanel_ 被原版通配 include("NotificationPanel_", true)
			拉入 NotificationPanel 上下文（同条目7/18/19 机制），仅 ImportFiles 导入 VFS 无需
			LuaContext；DealRemind 链式覆写 OnDefaultAddNotification（外交通知自动展开 + 九种
			请求文本命中播提示音，3 秒冷却），GreatPerson 链式覆写 RegisterHandlers（挂
			NOTIFICATION_OTHER_PLAYER_RECRUITED_GREATPERSON handler，他人招募伟人即发本地通知，
			Activate 复用原版 OnClaimGreatPersonActivate，条目26扩展入栈即自动展开不加提示音）。开关收编条目12 MPT_Settings 两行
			（NotificationPanel_DealRemind 沿用 1.67 原 key 默认开 / NotificationPanel_GreatPersonRecruited
			自造 key 默认开），lua 侧订阅 MPT_Settings_Toggle 单通道广播（条目26规范删
			TPT_Settings_Toggle 双通道行，同条目25规范裁决）；与 1.67 同装时其 NDR/NOC 与
			本条目两文件四通配共载（交易提醒双响）、与源 mod 2459772036 同装伟人通知双份，
			均建议二选一启用。条目26修复：DealRemind 查册局部变量误加 :table 标注被引擎
			赋值期类型检查拒绝（GetNotificationEntry 返回 hmake 'NotificationType' 引擎
			实例非纯 Lua 表，每次通知到达 Type check failed 中断包裹 → 展开与提示音永不
			执行），去标注同条目21 引擎对象标注坑，另补条目有册无 UI 实例时 m_Instance
			nil 守卫 -->
		<ImportFiles id="IG_NDR_Import">
			<Properties>
				<LoadOrder>1010</LoadOrder>
			</Properties>
			<File>InGame/NotificationDealRemind/NotificationPanel_MPT_DealRemind.lua</File>
			<File>InGame/NotificationDealRemind/NotificationPanel_MPT_GreatPerson.lua</File>
		</ImportFiles>
