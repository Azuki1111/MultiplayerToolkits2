<!-- 条目34：反作弊监测面板布局（移植工坊 3775385784「反作弊监控」UI/HashCheckInGameUI.xml）-->
<!-- 空 Context，经 AddUserInterfaces(Context=InGame) 注册、modinfo criteria        -->
<!-- MPT_HASH_CHECK 门控（不勾选零加载）；同名 Lua MPT_HashCheckUI.lua 自动执行。      -->
<!-- 入口改造（用户裁决）：删除原版 LaunchBar 注入实例（LaunchBarItem/LaunchBarPinInstance   -->
<!-- 与 AttachLaunchButton 全套），改由条目8 MPT_QuickPanel「反作弊监测」按钮经           -->
<!-- LuaEvents.MPT_HashCheck_Toggle 跨 Context 触发开关（条目11/12 同款）。             -->
<!-- 面板本体原样保留：480x560 居中主面板 + 滚动玩家列表 + 无玩家提示；                  -->
<!-- 状态数据来自钩子 DLL 注入的 HashCheckDLL 全局（HashCheck_GameCores.sql 重定向），     -->
<!-- DLL 未加载时 Lua 端优雅降级显示「等待数据...」。                                    -->
<!-- ============================================================================ -->
<Context>
	<Container Style="FullScreenVignetteConsumer" Size="parent,parent-29" />
	<Box ID="Main" Anchor="C,C" Size="480,560" Color="11,27,40,255">
		<Grid Anchor="C,C" Size="parent+9,parent+9" Style="WindowFrameTopOnly" />
		<Button ID="CloseButton" Anchor="R,T" Offset="-3,-1" Size="44,44" Texture="Controls_CloseLarge" />
		<Image Anchor="C,T" Size="parent,44" Color="61,112,154,255" Texture="Controls_Gradient_HalfRadial" />
		<Label Anchor="C,T" Offset="0,14" Style="FontFlair24" String="LOC_MPT_HASHCHECK_PANEL_TITLE" FontStyle="Glow" Color0="133,205,235,255" Color1="203,215,225,100" Color2="254,254,254,255" SmallCaps="28" SmallCapsType="EveryWord" />
		<Grid Anchor="C,T" Offset="0,44" Size="parent-6,8" Style="Divider3Grid" />

		<Grid Style="SubContainer" Size="parent-24,parent-64" Anchor="C,T" Offset="0,56">
			<ScrollPanel ID="Listings" Anchor="C,T" Size="parent,parent-16" Offset="0,8" Vertical="1" AutoScrollBar="1">
				<Stack ID="PlayerListStack" Anchor="C,T" StackGrowth="Down" Padding="5" Offset="0,0"/>
			</ScrollPanel>
		</Grid>
		<Label ID="NoPlayersLabel" Anchor="C,C" Offset="0,150" Style="FontNormal16" String="LOC_MPT_HASHCHECK_NO_OTHER_PLAYERS" Hidden="1"/>
	</Box>

	<Instance Name="PlayerStatusEntry">
		<Container ID="RootContainer" Size="420,46">
			<GridButton ID="EntryButton" Anchor="C,T" Offset="0,0" Size="420,46" Texture="Controls_ButtonControl" SliceCorner="12,12" SliceTextureSize="24,24" StateOffsetIncrement="0,24">
				<Image ID="LeaderIcon" Anchor="L,C" Offset="6,0" Size="36,36"/>
				<ScrollTextField ID="PlayerName" Anchor="L,C" Offset="50,0" Size="260,16" Style="WhiteSemiBold14" String="PlayerName"/>
				<Label ID="StatusLabel" Style="WhiteSemiBold14" Anchor="R,C" Offset="12,0" String="..."/>
			</GridButton>
		</Container>
	</Instance>
</Context>
