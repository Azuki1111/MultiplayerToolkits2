<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================ -->
<!-- 条目8：WorldTracker 快捷操作面板（投降 / 重新开始）                            -->
<!-- 空 Context，经 AddUserInterfaces(Context=InGame) 注册；同名 Lua              -->
<!-- MPT_QuickPanel.lua 自动执行，LoadGameViewStateDone 时把本面板 ChangeParent   -->
<!-- 挂进原版 /InGame/WorldTracker/PanelStack（仿作弊面板 mod 的挂载方式）。        -->
<!-- 点击标题 HeaderTitle 展开/收起；展开后显示「投降」「重新开始」两按钮。          -->
<!-- 「投降」为团队投降投票（条目8续）：展开区含投票进度/同意反对按钮/状态提示，      -->
<!-- 仅同队玩家可见；投票状态经 Game:SetProperty 跨端同步（见 SurrenderVote_Gameplay.lua）-->
<!-- ============================================================================ -->
<Context>
	<!-- 每帧回调源：不可见 AlphaAnim（隐藏也持续 tick，原版 CountdownTimerAnim 同款；Civ6 无 SetUpdateHandler） -->
	<AlphaAnim ID="MPT_PollAnim" Size="1,1" AlphaStart="0" AlphaEnd="0"/>
	<Grid ID="QuickPanel" Offset="0,0" Size="296,25" Texture="Controls_DropdownPanel" Color="143,122,82,200" Anchor="L,T" ConsumeMouseOver="1" Hidden="0">
		<Box Offset="0,0" Size="parent-5,default" Color="143,122,82,200">
			<Image Texture="Controls_GradientSmall" Size="parent+5,20" Color="0,0,0,255" Anchor="L,T"/>
			<Container ID="PanelContainer" Offset="0,0" Align="Center" Size="parent,1">
				<Button ID="HeaderTitle" Anchor="C,C" Offset="0,5" ConsumeAllMouse="1" Size="250,23">
					<Label ID="PanelTitle" Anchor="C,C" Offset="0,7" Align="Center" Size="200,90" WrapWidth="Parent-40" Style="FontFlair16" Color2="143,122,82,255" Color0="106,93,69,230" SmallCaps="20" SmallCapsLeading="0" SmallCapsType="EveryWord" KerningAdjustment="0" String="LOC_MPT_QUICK_HEADER"/>
				</Button>
				<!-- 展开区：投降 / 重新开始 两个按钮 -->
				<Stack ID="ExpandStack" Anchor="C,T" Offset="0,30" StackGrowth="Down" Padding="4" Hidden="1">
					<GridButton ID="SurrenderButton" Size="286,32" Style="TabButton" Anchor="C,T" FontSize="14" String="LOC_MPT_QUICK_SURRENDER"/>
					<GridButton ID="RestartButton" Size="286,32" Style="TabButton" Anchor="C,T" FontSize="14" String="LOC_MPT_QUICK_RESTART"/>
					<!-- 条目8续：投降投票状态区（仅投票进行中/已通过时显示；texture 用原版 Emergency 贴图，尺寸对齐原版 Crisis 面板行高 44） -->
					<Container ID="VoteArea" Anchor="C,T" Size="296,44" Hidden="1">
						<GridButton ID="VoteBacking" Size="296,44" Texture="EMERGENCY_BACKSTAB_BG3" SliceCorner="66,0" SliceSize="42,42" SliceTextureSize="110,44" Anchor="C,T" ConsumeMouseOver="1" Hidden="1"/>
						<Stack ID="VoteContent" Anchor="C,T" Offset="0,3" StackGrowth="Down" Padding="2">
							<Label ID="VoteStatusLabel" Anchor="C,T" Style="FontNormal12" Color="255,255,255,255" String="LOC_MPT_VOTE_TITLE" WrapWidth="270" Align="Center"/>
							<Label ID="VoteProgressLabel" Anchor="C,T" Style="FontNormal12" Color="208,212,217,255" WrapWidth="270" Align="Center"/>
							<Stack Anchor="C,T" StackGrowth="Right" StackPadding="6">
								<GridButton ID="VoteAgreeButton" Style="ButtonConfirm" Anchor="C,T" String="LOC_MPT_VOTE_AGREE" Size="130,28"/>
								<GridButton ID="VoteDisagreeButton" Style="ButtonRed" Anchor="C,T" String="LOC_MPT_VOTE_DISAGREE" Size="130,28"/>
							</Stack>
						</Stack>
					</Container>
				</Stack>
			</Container>
		</Box>
		<!-- 装饰分隔线（仿作弊面板 ButtonSep2/ButtonSep）：头部下方一条始终显示，展开区底部一条展开时显示 -->
		<Box ID="QuickSepTop" Color="143,122,82,200" Anchor="L,T" Size="parent,2" Offset="0,23" Hidden="0">
			<Box Color="0,0,0,200" Anchor="L,T" Size="parent,1" AnchorSide="I,O"/>
			<Box Color="0,0,0,200" Anchor="L,B" Size="parent,1" AnchorSide="I,O"/>
		</Box>
		<Box ID="QuickSepBottom" Color="143,122,82,200" Anchor="L,T" Size="parent,2" Offset="0,108" Hidden="1">
			<Box Color="0,0,0,200" Anchor="L,T" Size="parent,1" AnchorSide="I,O"/>
			<Box Color="0,0,0,200" Anchor="L,B" Size="parent,1" AnchorSide="I,O"/>
		</Box>
	</Grid>
</Context>
