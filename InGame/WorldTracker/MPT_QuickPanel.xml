<!-- 条目8：WorldTracker 快捷操作面板（投降 / 重新开始）                            -->
<!-- 空 Context，经 AddUserInterfaces(Context=InGame) 注册；同名 Lua              -->
<!-- MPT_QuickPanel.lua 自动执行，LoadGameViewStateDone 时把本面板 ChangeParent   -->
<!-- 挂进原版 /InGame/WorldTracker/PanelStack（仿作弊面板 mod 的挂载方式）。        -->
<!-- 点击标题 HeaderTitle 展开/收起；展开后显示「投降」「重新开始」两按钮，          -->
<!-- 按钮响应暂不配置（空回调 + TODO，见 Lua）。                                    -->
<!-- ============================================================================ -->
<Context>
	<Grid ID="QuickPanel" Offset="0,0" Size="296,25" Texture="Controls_DropdownPanel" Color="143,122,82,200" Anchor="L,T" ConsumeMouseOver="1" Hidden="0">
		<Box Offset="0,0" Size="parent-5,default" Color="143,122,82,200">
			<Image Texture="Controls_GradientSmall" Size="parent,20" Color="0,0,0,255" Anchor="L,T"/>
			<Container ID="PanelContainer" Offset="0,0" Align="Center" Size="parent,1">
				<Button ID="HeaderTitle" Anchor="C,C" Offset="0,5" ConsumeAllMouse="1" Size="250,23">
					<Label ID="PanelTitle" Anchor="C,C" Offset="0,7" Align="Center" Size="200,90" WrapWidth="Parent-40" Style="FontFlair16" Color2="143,122,82,255" Color0="106,93,69,230" SmallCaps="20" SmallCapsLeading="0" SmallCapsType="EveryWord" KerningAdjustment="0" String="LOC_MPT_QUICK_HEADER"/>
				</Button>
				<!-- 展开区：投降 / 重新开始 两个按钮（响应未配置，TODO 见 Lua） -->
				<Stack ID="ExpandStack" Anchor="C,T" Offset="0,15" StackGrowth="Down" Padding="4" Hidden="1">
					<GridButton ID="SurrenderButton" Size="286,32" Style="TabButton" Anchor="C,T" FontSize="14" String="LOC_MPT_QUICK_SURRENDER"/>
					<GridButton ID="RestartButton" Size="286,32" Style="TabButton" Anchor="C,T" FontSize="14" String="LOC_MPT_QUICK_RESTART"/>
				</Stack>
			</Container>
		</Box>
		<!-- 底部装饰分隔线（展开时随面板高度下移） -->
		<Box ID="QuickSep" Color="143,122,82,200" Anchor="L,T" Size="parent+5,2" Offset="0,23" Hidden="0">
			<Box Color="0,0,0,200" Anchor="L,T" Size="parent,1" AnchorSide="I,O"/>
			<Box Color="0,0,0,200" Anchor="L,B" Size="parent,1" AnchorSide="I,O"/>
		</Box>
	</Grid>
</Context>
